# GitHub App credentials (from your app's settings page)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=

# Morph — powers WarpGrep codebase search during review
MORPH_API_KEY=

# Reviewer LLM. The engine defaults to provider="openai", model="gpt-5.4".
# ANTHROPIC_API_KEY is required regardless: WarpGrep is exposed as an
# Anthropic tool during the review loop.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional
MAX_CONCURRENT_REVIEWS=3
MAX_ISSUES_PER_PR=8
LOG_LEVEL=INFO

# Axiom telemetry (optional — reviews run fine without it)
AXIOM_TOKEN=
AXIOM_DATASET=morph-pr-review
